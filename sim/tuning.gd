## The spec for a fighter kind, by its Swift case name ("scrapDrone").
func spec(kind: String) -> Specs.FighterSpec:
	match kind:
		"caelen":
			return caelen
		"seraphine":
			return seraphine
		"nimue":
			return nimue
		"decoy":
			return decoy
		"orion":
			return orion
		"dummy":
			return dummy
		"scrapDrone":
			return scrap_drone
		"forgedSoldier":
			return forged_soldier
		"sentryCore":
			return sentry_core
		"dogmaFrame":
			return dogma_frame
		"theProtocol":
			return the_protocol
		"ratborn":
			return ratborn
		"lanternGunner":
			return lantern_gunner
		"smugglerBrute":
			return smuggler_brute
		"nightWeaver":
			return night_weaver
		"weaverImage":
			return weaver_image
		"zealot":
			return zealot
		"radiantAcolyte":
			return radiant_acolyte
		"solarGuard":
			return solar_guard
		"haloDisciple":
			return halo_disciple
		"lastOracle":
			return last_oracle
		"lineWarden":
			return line_warden
		"lamplighter":
			return lamplighter
		"swornShield":
			return sworn_shield
		"swornSpear":
			return sworn_spear
		"cinderKing":
			return cinder_king
		"mason":
			return mason
		"heart":
			return heart
	push_error("Tuning: no spec for %s" % kind)
	return null
